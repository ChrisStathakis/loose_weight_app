{
  "expo": {
    "name": "Daily Plate",
    "slug": "daily-plate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "scheme": "dailyplate",
    "android": {
      "package": "com.dailyplate.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3EBDD"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E7A4F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Daily Plate to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "react-native-health-connect",
      "expo-localization",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
